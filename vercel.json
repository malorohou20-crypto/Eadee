{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!eadee-app-v2\\.html$|test-renderer-v3\\.html$).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate-plan.js": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/public/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/public/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/public/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp|woff2|woff))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(index\\.html|eadee-app-v2\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
